#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT_DIR"

CONFIG="${1:?Usage: $0 <experiment.json>}"

if [[ ! -f "$CONFIG" ]]; then
  if [[ -f "$ROOT_DIR/$CONFIG" ]]; then
    CONFIG="$ROOT_DIR/$CONFIG"
  else
    echo "Error: config file not found: $1" >&2
    exit 1
  fi
fi

if ! command -v jq &>/dev/null; then
  echo "Error: jq is required to parse $CONFIG" >&2
  exit 1
fi

LOGDIR=$(jq -r '.ppo_lstm_agent_log_dir // "logs"' "$CONFIG")
MODELS_DIR=$(jq -r '.ppo_lstm_agent_models_dir // empty' "$CONFIG")
TB_LOG_NAME=$(jq -r '.experimentName // empty' "$CONFIG")

if [[ -z "$MODELS_DIR" || "$MODELS_DIR" == "null" ]]; then
  echo "Error: JSON must include non-empty ppo_lstm_agent_models_dir" >&2
  exit 1
fi

if [[ -z "$TB_LOG_NAME" || "$TB_LOG_NAME" == "null" ]]; then
  echo "Error: JSON must include non-empty experimentName (used as --tb-log-name)" >&2
  exit 1
fi

echo "            _____ _______    _____ _    _ _____ _______ 
     /\    / ____|__   __|  / ____| |  | |_   _|__   __|
    /  \  | (___    | |    | (___ | |  | | | |    | |   
   / /\ \  \___ \   | |     \___ \| |  | | | |    | |   
  / ____ \ ____) |  | |     ____) | |__| |_| |_   | |   
 /_/    \_\_____/   |_|    |_____/ \____/|_____|  |_|   
                                                        
                                                        "
echo "Starting experiment: $TB_LOG_NAME (config: $CONFIG)"

AGENT_DIR="${ROOT_DIR}/scaling-agents/LSTM-PPO"
LOADGEN_DIR="${ROOT_DIR}/workload-generator"
loadgen_cmd=$(printf 'cd %q && python3 request_generator.py' "$LOADGEN_DIR")
agent_cmd=$(printf 'cd %q && python3 agent.py --logdir %q --models-dir %q --tb-log-name %q' \
  "$AGENT_DIR" "$LOGDIR" "$MODELS_DIR" "$TB_LOG_NAME")

tmux new-window -n loadgen bash -lc "$loadgen_cmd"
tmux new-window -n agent bash -lc "$agent_cmd"
